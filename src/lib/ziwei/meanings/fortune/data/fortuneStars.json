    "appliesTo": [
      "major",
      "minor"
    ],
    "starNameAliases": {
      "貧狼星": "貪狼星",
      "貧狼": "貪狼星",
      "右輔星": "右弼星",
      "敬羊星": "擎羊星",
      "敬羊": "擎羊星",
      "擎羊": "擎羊星",
      "陀羅": "陀羅星",
      "鈴星": "鈴星",
