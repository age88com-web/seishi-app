[
 {
  "id": "N-ST-0829",
  "text": "化禄・化権・化科・化忌の四つをまとめて、化曜星と呼びます。",
  "ref": {
   "source": "紫微斗数入門",
   "pdfPage": 72,
   "docPage": 73,
   "section": "4.諸星曜の意味と命宮における判断／化曜星"
