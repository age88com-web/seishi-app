# このファイルはコミット対象（.env.example）。実際の秘密値は絶対に書かない。
# 開発環境では .env.local（.gitignore済み）へ実際の値を設定すること。
# 本番（VPS）では OS の環境変数 / PM2 の ecosystem 設定などで渡すこと。

# --- 認証DB（既存・専門家向け /takujitsu 等） ---
# 認証DB（ユーザー・セッション）の絶対パス。public/ 配下や git 管理下には置かない。
DB_PATH=

# --- 一般向け擇日アプリ /lucky-day の会員認証（WordPress + Paid Memberships Pro） ---
# WordPress本体のURL（末尾スラッシュなし）。
WORDPRESS_URL=
# WordPress Application Password のユーザー名。
TAKUJITSU_WP_USER=
# WordPress Application Password（本物の値は絶対にここへ書かない）。
TAKUJITSU_WP_APP_PASSWORD=
# /lucky-day 専用セッション署名鍵。十分に長いランダム値を使うこと
# （例: `openssl rand -hex 32`。本物の値は絶対にここへ書かない）。
TAKUJITSU_SESSION_SECRET=

# --- /lucky-day 開発専用オーバーライド（ローカルdevのみ有効） ---
# NODE_ENV==="development" かつ この値が文字列 "true" の場合だけ、
# ローカルの /lucky-day を有料会員（levelId=2相当）として扱う。
# 本番のWordPress認証・PMPro・Stripe・セッションには一切影響しない
# （src/lib/luckyDay/auth/member.ts の isDevPaidMemberOverrideEnabled()）。
# .env.local にだけ設定すること。.env.production・.env.production.local
# には絶対に追加しないこと。
TAKUJITSU_DEV_PAID_MEMBER=

# --- 専門家向け認証ゲートの開発専用バイパス（ローカルdevのみ有効） ---
# NODE_ENV==="development"（next dev）かつ この値が文字列 "true" の場合だけ、
# src/proxy.ts の認証チェックをスキップしてログイン不要にする。
# next build / next start では NODE_ENV が "production" になるため無効。
# 認証DB・既存ユーザー・login/logout処理には一切影響しない。
# .env.local にだけ設定すること。.env.production・.env.production.local
# には絶対に追加しないこと。
SEISHI_DEV_AUTH_BYPASS=
